# Django secrets
SECRET_KEY=super-insecure-django-key
DEBUG=True
ALLOWED_HOSTS=*
ENV_NAME=DEV
SQLITE3=True

# HTTPS hardening, only applied when DEBUG is not True
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=True

# Database secrets
PGHOST=localhost
PGDATABASE=example_db
PGUSER=postgres
PGPASSWORD=12345678
PGPORT=5432

# Super user information
SUPERUSER_EMAIL=superuser@example.com
